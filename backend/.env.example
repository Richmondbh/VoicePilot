# Copy this file to `.env` and change what you need.

# ---- Which AI model interprets your commands ----
# ollama = free, runs on your PC (install from https://ollama.com, then: ollama pull llama3.2:3b)
# groq   = free cloud tier (key from https://console.groq.com/keys)
# openai = paid but cheap (gpt-4o-mini)
# none   = no LLM; uses the trained classifier / keyword rules (works offline, zero setup)
LLM_PROVIDER=ollama
# LLM_MODEL=            # optional override, e.g. qwen2.5:3b, llama-3.1-8b-instant, gpt-4o-mini

GROQ_API_KEY=
OPENAI_API_KEY=

# Prompt version used by the app: v1 | v2 | v3 (v3 = best, with memory + history)
PROMPT_VERSION=v3
HISTORY_TURNS=5

# ---- Speech recognition (local faster-whisper) ----
# tiny | base | small  (bigger = more accurate but slower)
WHISPER_MODEL=base
WHISPER_LANGUAGE=en

# ---- Actions ----
# 1 = only pretend to open apps/folders/websites (good for testing)
DRY_RUN=0
# NOTES_DIR=C:\Users\you\Documents\VoicePilot Notes
